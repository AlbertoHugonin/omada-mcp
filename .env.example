# omada-mcp configuration
# Copy to .env and fill in. NEVER commit .env — it contains secrets.

# --- Omada controller connection (required) ---

# Controller URL, including scheme and port. No trailing slash.
OMADA_BASE_URL=https://omada.local:8043

# Open API OAuth2 client-credentials, created in the controller UI under
# Settings -> Platform Integration. See docs/SETUP.md.
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=

# Controller ID (omadacId). See docs/SETUP.md for how to find it.
OMADA_OMADAC_ID=

# --- Omada controller connection (optional) ---

# Default site ID. If unset, tools require an explicit siteId argument.
OMADA_SITE_ID=

# TLS certificate verification. Set to false only for self-signed certs.
OMADA_VERIFY_TLS=true
# Optional private/self-signed CA PEM file.
OMADA_TLS_CA_FILE=
# Optional exact leaf certificate SHA-256 fingerprint. When configured, the
# fingerprint replaces hostname matching while CA/chain verification remains enabled.
OMADA_TLS_CERT_SHA256=

# HTTP request timeout in milliseconds.
OMADA_TIMEOUT_MS=30000

# --- Capability profile ---

# safe-read  : read-only tools (default)
# ops-write  : safe-read + low-risk operational writes, including client name/fixed IP
# admin      : everything, including SSID / AP radio / site-roaming config
OMADA_CAPABILITY_PROFILE=safe-read

# --- MCP transport ---

# stdio (default) or http
MCP_TRANSPORT=stdio

# HTTP transport requires this explicit opt-in AND MCP_TRANSPORT=http.
MCP_HTTP_ENABLE=false

# Bind address for HTTP mode. Keep loopback unless the MCP must be reached from
# another host/container; for Docker/LAN deployments use 0.0.0.0 plus firewalling.
MCP_HTTP_BIND=127.0.0.1

# HTTP port. Streamable HTTP is served at /mcp; liveness is /healthz.
MCP_HTTP_PORT=3000

# Required whenever MCP_TRANSPORT=http. Jarvis should send this value in the
# X-API-Key request header. Minimum 16 characters; use a long random secret.
MCP_HTTP_API_KEY=

# --- Logging ---

# debug | info | warn | error
LOG_LEVEL=info
